<Window x:Class="DreadsMashedPatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dread's Mashed Patch"
        Width="1040"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#182432" Padding="22,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dread's Mashed Patch" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Standalone Skyrim conflict-forwarding patcher" Foreground="#C5D0DC" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="90" Height="7" Margin="0,0,12,0" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ElapsedText}" Foreground="#C5D0DC" FontFamily="Consolas" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,14,16,8">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Game paths" />
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Choose the game folder, its Data folder, and the active load order. Dread's Mashed Patch.esp is written to the selected Data folder." />

                        <Button Content="Detect paths" Click="OnAutoDetectPaths" HorizontalAlignment="Left" Margin="0,5,0,7" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Game release" />
                        <ComboBox ItemsSource="{Binding GameReleaseChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.GameRelease}" />
                        <TextBlock Style="{StaticResource HelpText}" Text="Anniversary Edition uses the Special Edition selection. Choose the platform whose game and load-order files you selected." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Skyrim game folder" />
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseGameFolder" Margin="8,0,0,0" />
                            <TextBox Text="{Binding Settings.GameFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource HelpText}" Text="Contains SkyrimSE.exe or SkyrimVR.exe and Skyrim.ccc. For Wabbajack, this is normally the Stock Game folder." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Skyrim Data folder" />
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseDataFolder" Margin="8,0,0,0" />
                            <TextBox Text="{Binding Settings.DataFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Load order file (plugins.txt)" />
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseLoadOrder" Margin="8,0,0,0" />
                            <TextBox Text="{Binding Settings.LoadOrderFilePath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="If Dread's Mashed Patch.esp is already in this load order, only enabled plugins before it are read. Otherwise, the complete enabled load order is read." />

                        <Border Background="#FFF7E6" BorderBrush="#E8C77A" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,15,0,0">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Mod Organizer 2: " />
                                <Run Text="Add DreadsMashedPatch.exe as an executable and launch it from the active MO2 instance. Select that profile's plugins.txt. The generated plugin may appear in MO2's configured output mod or Overwrite." />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Record Types">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Record families" />
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Only enabled record families are written by the patcher. Search by an xEdit record signature such as QUST or by a friendly name such as Quest. Arrow keys navigate the list; Space toggles the selected row." />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RecordSearchBox"
                                 Text="{Binding RecordSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search record types (Ctrl+F)"
                                 AutomationProperties.Name="Search record types" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="Enable all" Click="OnEnableAll" />
                            <Button Content="Disable all" Click="OnDisableAll" />
                            <Button Content="Invert" Click="OnInvert" Margin="0" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelBrush}" Padding="10,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding ShownRecordTypeCountText}" FontWeight="SemiBold" />
                            </Border>
                            <ListBox x:Name="RecordTypeList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding RecordTypesView}"
                                     BorderThickness="0"
                                     PreviewKeyDown="OnRecordTypeListPreviewKeyDown"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="Record types">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  ToolTip="{Binding DisplayName}"
                                                  Padding="3,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Signature}" FontFamily="Consolas" FontWeight="SemiBold" Width="55" />
                                                <TextBlock Text="{Binding DisplayName}" MinWidth="240" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Forwarding Policies">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Record-specific forwarding policies" />
                        <TextBlock Style="{StaticResource HelpText}" Text="These policies control fields whose relationships make ordinary property-by-property forwarding unsafe or ambiguous." />

                        <CheckBox Content="Treat Creation Club content as official baseline"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Forwarding.TreatCreationClubAsVanilla}" />
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Enabled: Creation Club records are treated like Bethesda base-game content for early-exit checks. Disabled: Creation Club plugins are treated like normal mods and their conflicts are eligible for forwarding." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="NPC protection status" />
                        <ComboBox ItemsSource="{Binding ProtectionPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.ProtectionPolicy}" />
                        <TextBlock Style="{StaticResource HelpText}" Text="Controls how None, Protected, and Essential status changes compete across NPC overrides." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Perks" />
                        <ComboBox ItemsSource="{Binding PerkPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.PerkPolicy}" />
                        <TextBlock Style="{StaticResource HelpText}" Text="Atomic mode avoids combining mutually dependent PERK data from different owners." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Quests" />
                        <ComboBox ItemsSource="{Binding QuestPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.QuestPolicy}" />
                        <TextBlock Style="{StaticResource HelpText}" Text="Atomic mode preserves coherent quest stage, objective, alias, and virtual-machine structures." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Story Manager nodes" />
                        <ComboBox ItemsSource="{Binding StoryManagerPolicies}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Patcher.Forwarding.StoryManagerPolicy}" />
                        <TextBlock Style="{StaticResource HelpText}" Text="Atomic mode preserves coherent Story Manager topology and configuration." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Compatibility Rules">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Compatibility and overwrite authority" />
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="A rule lets selected target mods behave as though they declare another plugin as a master. This can authorize intentional reversions without modifying either plugin file." />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Add rule" Click="OnAddCompatibilityRule" />
                                <Button Content="Remove" Click="OnRemoveCompatibilityRule" Margin="0" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding CompatibilityRules}"
                                     SelectedItem="{Binding SelectedCompatibilityRule}"
                                     DisplayMemberPath="DisplayName"
                                     AutomationProperties.Name="Compatibility rules" />
                        </DockPanel>

                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel DataContext="{Binding SelectedCompatibilityRule}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Plugin to inject as a virtual master" />
                                <TextBox Text="{Binding InjectedMaster, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="For example: Unofficial Skyrim Special Edition Patch.esp" />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="Use the complete plugin filename, including .esm, .esp, or .esl." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Target mods receiving this virtual master" />
                                <TextBox Height="230"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding TargetModsText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter one complete plugin filename per line." />
                                <TextBlock Style="{StaticResource HelpText}"
                                           Text="Enter one plugin filename per line. These mods may then intentionally revert changes owned by the injected plugin." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Logging and deep-dive diagnostics" />
                        <TextBlock Style="{StaticResource HelpText}" Text="Warnings and run progress are always shown. Debug mode adds property decision details and targeted deep dives; it can produce very large logs." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Historical logs to keep" />
                        <TextBlock Style="{StaticResource HelpText}" Text="The current log is always kept. Completed run logs are timestamped, and the oldest are removed when this limit is exceeded. Use 0 to retain only the current log." />
                        <TextBox Width="120" HorizontalAlignment="Left" Margin="0,0,0,12"
                                 Text="{Binding Settings.HistoricalLogsToKeep, UpdateSourceTrigger=LostFocus}" />

                        <CheckBox x:Name="DebugModeCheck"
                                  Content="Enable debug mode"
                                  FontWeight="SemiBold"
                                  IsChecked="{Binding Settings.Patcher.Diagnostics.DebugMode}" />

                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=DebugModeCheck}" Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Verbosity" />
                            <ComboBox ItemsSource="{Binding LogVerbosityValues}"
                                      SelectedItem="{Binding Settings.Patcher.Diagnostics.Verbosity}" />
                            <CheckBox Content="Print enabled record types at startup"
                                      IsChecked="{Binding Settings.Patcher.Diagnostics.EnableStartupDiagnostics}" />
                            <CheckBox Content="Include unchanged decisions in Detailed mode"
                                      IsChecked="{Binding Settings.Patcher.Diagnostics.IncludeNoChangeDecisionsInDetailed}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Maximum value preview length" />
                            <TextBox Width="120" HorizontalAlignment="Left"
                                     Text="{Binding Settings.Patcher.Diagnostics.MaxValuePreviewLength, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Deep-dive record signatures" />
                            <TextBlock Style="{StaticResource HelpText}" Text="One xEdit record signature per line, for example QUST." />
                            <TextBox Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DeepDiveRecordSignaturesText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Deep-dive FormKeys" />
                            <TextBlock Style="{StaticResource HelpText}" Text="One FormKey per line, for example 00285D:Update.esm. Bare hexadecimal FormIDs are also accepted." />
                            <TextBox Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DeepDiveFormKeysText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Deep-dive properties" />
                            <TextBlock Style="{StaticResource HelpText}" Text="Optional xEdit field signatures such as EDID, FULL, DESC, KWDA, VMAD, or CTDA. Friendly property names such as Responses are also accepted. Leave empty to inspect every property on matching records." />
                            <TextBox Height="72" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DeepDivePropertiesText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="RunLogTab" Header="Run Log">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Copy log" Click="OnCopyLog" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearLog" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Open logs folder" Click="OnOpenLogsFolder" Margin="8,0,0,0" />
                        <TextBlock Text="Run output" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="RunLogTextBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Patcher run log" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,11">
            <DockPanel>
                <TextBlock Text="Portable settings and logs are stored beside DreadsMashedPatch.exe"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save settings" Click="OnSave">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Run patcher" Click="OnRun" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
