<Window x:Class="DreadsMashedPatch.App.InstallationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Skyrim installation"
        Width="680"
        Height="360"
        MinWidth="520"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Several Skyrim installations were found" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="Choose the installation this patcher should use. Wabbajack Stock Game folders can be selected manually from the General tab." />
        </StackPanel>

        <ListBox x:Name="InstallationList" Grid.Row="1" MouseDoubleClick="OnInstallationDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="7,5">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding GameFolder}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Use installation" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="OnUseInstallation" />
        </StackPanel>
    </Grid>
</Window>
